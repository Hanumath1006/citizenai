# ─────────────────────────────────────────────────────────────
# CitizenAI environment variables
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key: server-only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (itinerary generation) — get a key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-key
# Model used for planning the itinerary shape
GEMINI_MODEL=gemini-3.6-flash

# Google Maps Platform (Places API New + Routes API)
# Server-side key — restrict by API in Google Cloud Console
GOOGLE_MAPS_API_KEY=your-google-maps-key

# OpenWeather (forecast for weather-aware planning)
OPENWEATHER_API_KEY=your-openweather-key

# App URL (used for OAuth redirect); no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
